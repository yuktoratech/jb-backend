PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated exact browser origins. Requests without Origin remain allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_FORGOT_RATE_LIMIT_MAX=5
AUTH_FORGOT_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_RATE_LIMIT_MAX=5
AUTH_RESET_RATE_LIMIT_WINDOW_MS=900000

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=900
PRODUCT_IMAGE_MAX_BYTES=8388608

# Base64-encoded Firebase service-account JSON. If omitted, Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
