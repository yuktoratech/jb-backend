PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated exact browser origins. Requests without Origin remain allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Public Admin URL that receives the one-time token as a `token` query parameter.
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# SMTP auth is optional for trusted relays, but SMTP_USER and SMTP_PASSWORD must be set together.
EMAIL_FROM="Just BLACK <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Require STARTTLS whenever SMTP_SECURE is false. Keep true outside isolated local test relays.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=10000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_FORGOT_RATE_LIMIT_MAX=5
AUTH_FORGOT_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_RATE_LIMIT_MAX=5
AUTH_RESET_RATE_LIMIT_WINDOW_MS=900000

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=900
PRODUCT_IMAGE_MAX_BYTES=8388608

# Base64-encoded Firebase service-account JSON. If omitted, Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
